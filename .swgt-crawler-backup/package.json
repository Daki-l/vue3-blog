{
  "name": "swgt-crawler",
  "version": "1.1.0",
  "description": "Local crawler & SQLite archive for public swgt.io data (Summoners War monsters, 3MDC defenses/counters, guides, balance patches)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "crawl": "node src/cli.js all",
    "crawl:catalog": "node src/cli.js catalog",
    "crawl:monsters": "node src/cli.js monsters",
    "crawl:defenses": "node src/cli.js defenses",
    "crawl:pages": "node src/cli.js pages",
    "crawl:images": "node src/cli.js images",
    "update": "node src/cli.js update",
    "backup": "node src/cli.js backup",
    "restore": "node src/cli.js restore",
    "stats": "node src/cli.js stats",
    "export": "node src/cli.js export"
  }
}
